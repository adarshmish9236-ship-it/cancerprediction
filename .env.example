# ==============================================================================
# CANCERWISE AI — Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# SECURITY DIRECTIVE: NEVER commit real .env files or credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Environment & Identity
# ------------------------------------------------------------------------------
PROJECT_NAME="CANCERWISE AI"
PROJECT_ENV="development"                 # development | staging | production
PROJECT_VERSION="1.0.0"
LOG_LEVEL="INFO"                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
CLINICAL_DISCLAIMER_ENABLED=true          # Mandatory for clinical decision support prototype

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Configuration
# ------------------------------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"
API_RELOAD=false                          # Set true only in local development
API_WORKERS=1                            # Scale to 2-4 in high-throughput production
API_SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-string"
API_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_BYTES=104857600           # 100 Megabytes
ALLOWED_CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"

# ------------------------------------------------------------------------------
# 3. Streamlit Frontend Configuration
# ------------------------------------------------------------------------------
STREAMLIT_HOST="0.0.0.0"
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_RUN_ON_SAVE=false
API_BASE_URL="http://localhost:8000/api/v1"  # In docker use: http://backend:8000/api/v1

# ------------------------------------------------------------------------------
# 4. Storage & Artifact File Paths
# ------------------------------------------------------------------------------
DATA_RAW_PATH="./data/raw"
DATA_PROCESSED_PATH="./data/processed"
MODELS_TRAINED_PATH="./models/trained"
MODELS_REGISTRY_PATH="./models/registry"
MODELS_GOVERNANCE_PATH="./models/governance"
REPORTS_DIR="./reports"
LOGS_DIR="./logs"

# ------------------------------------------------------------------------------
# 5. MLflow Tracking & Experimentation
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI="sqlite:///./experiments/mlruns/mlflow.db"
MLFLOW_EXPERIMENT_NAME="cancerwise_governance"
MLFLOW_ALLOW_FILE_STORE=true

# ------------------------------------------------------------------------------
# 6. Hardware & Compute Concurrency
# ------------------------------------------------------------------------------
JOB_MANAGER_MAX_WORKERS=4                 # Asynchronous background execution threads
MODEL_RANDOM_SEED=42
MODEL_N_JOBS=-1                           # Use all available CPU cores for scikit-learn
DEVICE="cpu"                              # cpu | cuda | mps

# ------------------------------------------------------------------------------
# 7. Testing & Diagnostic Mode
# ------------------------------------------------------------------------------
DEBUG=false
TESTING=false
